# Telegram API Bilgileri (https://my.telegram.org adresinden alınacak)
API_ID=12345678
API_HASH=your_api_hash_here

# Yönlendirme Ayarları
# Kaynak kanal(lar) (örn: kaynak_kanal_adi veya -100 ile başlayan ID)
# Birden fazla kanal için virgülle ayırın: kanal1,-1001234567890
SOURCE_CHANNEL=kaynak_kanal_adi
# Hedef kişi/kanal(lar) (örn: hedef_kullanici_adi veya ID)
# Birden fazla hedef için virgülle ayırın: kullanici1,-1009876543210
TARGET_USER=hedef_kullanici_adi

# (Opsiyonel) Telethon oturum metni - export_session.py ile oluşturulabilir.
# Sunucuda (ör. Render/Railway) .session dosyası olmadan çalıştırmak için kullanılır.
SESSION_STRING=

# (Opsiyonel) Web sunucusu portu (varsayılan: 8080)
PORT=8080
